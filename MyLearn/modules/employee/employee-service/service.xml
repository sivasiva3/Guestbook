<?xml version="1.0"?>
<!DOCTYPE service-builder PUBLIC "-//Liferay//DTD Service Builder 7.4.0//EN" "http://www.liferay.com/dtd/liferay-service-builder_7_4_0.dtd">

<service-builder dependency-injector="ds" package-path="com.liferay.docs.employee">
	<namespace>EB</namespace>
	<entity local-service="true" name="Employee" remote-service="true" uuid="true">

		<!-- PK fields -->

		<column name="employeeId" primary="true" type="long" />
		<column name="groupId" type="long" />

		<!-- Audit fields -->

		<column name="companyId" type="long" />
		<column name="userId" type="long" />
		<column name="userName" type="String" />
		<column name="createDate" type="Date" />
		<column name="modifiedDate" type="Date" />

		<!-- Other fields -->

		<column name="name" type="String" />
		<column name="department" type="String" />
		<column name="role" type="String" />
		<column name="salary" type="long" />
		<column name="joinedDate" type="Date" />

		<!-- Order -->

		<order by="asc">
			<order-column name="name" />
		</order>

		<!-- Finder methods -->

		<finder name="G_N_D" return-type="Collection">
		<finder-column name="groupId" />
			<finder-column name="name" />
			<finder-column name="department" />
		</finder>
		<finder name="G_N" return-type="Collection">
			<finder-column name="groupId" />
			<finder-column name="name" />
		</finder>
		<finder name="GroupId" return-type="Collection">
			<finder-column name="groupId" />
		</finder>
		<finder name="EmployeeId" return-type="Collection">
			<finder-column name="employeeId" />
		</finder>
		<finder name="G_E" return-type="Collection">
			<finder-column name="groupId" />
			<finder-column name="employeeId" />
		</finder>
		<finder name="G_D_R" return-type="Collection">
			<finder-column name="groupId" />
			<finder-column name="role" />
			<finder-column name="department" />
		</finder>
		<finder name="G_D" return-type="Collection">
			<finder-column name="groupId" />
			<finder-column name="department" />
		</finder>
		<finder name="G_R" return-type="Collection">
			<finder-column name="groupId" />
			<finder-column name="role" />
		</finder>
		
		<exceptions>
			<exception>EmployeeDepartment</exception>
			<exception>EmployeeName</exception>
		</exceptions>
	
		<!-- References -->

		<reference entity="AssetEntry" package-path="com.liferay.portlet.asset" />
		<reference entity="AssetTag" package-path="com.liferay.portlet.asset" />
	</entity>
</service-builder>